# Compilacion
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /sirespaldos ./cmd/server

# Ejecucion: necesita los clientes mysqldump/mysql para respaldar y restaurar.
FROM alpine:3.20
RUN apk add --no-cache mariadb-client tzdata ca-certificates \
 && adduser -D -H -u 10001 respaldos \
 && mkdir -p /respaldos && chown respaldos /respaldos
COPY --from=build /sirespaldos /usr/local/bin/sirespaldos
USER respaldos
ENV TZ=America/Mexico_City DIR_RESPALDOS=/respaldos GIN_MODE=release
EXPOSE 3060
CMD ["sirespaldos"]
