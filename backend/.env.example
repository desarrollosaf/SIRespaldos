# Copie este archivo a backend/.env y llene los valores.

# Base administrativa (MySQL / MariaDB). En desarrollo, docker-compose.yml
# usa su propio contenedor y estos valores se ignoran.
DB_HOST=192.168.x.x
DB_PUERTO=3306
DB_USUARIO=sirespaldos
DB_PASSWORD=
DB_NOMBRE=sirespaldos

# Genere con: openssl rand -base64 48
JWT_SECRETO=
JWT_DURACION=10h

# Cifra las contraseñas de los servidores MySQL guardadas en la base administrativa.
# Genere con: openssl rand -base64 48  — NO la cambie después o deberá recapturar las contraseñas.
CLAVE_CIFRADO=

# Administrador inicial (solo se usa si no existe ningún usuario)
ADMIN_USUARIO=admin
ADMIN_PASSWORD=

# Carpeta donde se escriben los respaldos (montar aquí el NAS/NFS)
DIR_RESPALDOS=/respaldos
MAX_CONCURRENCIA=2
TIMEOUT_RESPALDO=6h

# Los servidores MySQL internos no usan SSL
MYSQL_SIN_SSL=true

CORS_ORIGEN=http://localhost:4200
TZ=America/Mexico_City

# Retención por defecto de respaldos manuales, en días (0 = permanente)
RETENCION_DEFECTO_DIAS=730
